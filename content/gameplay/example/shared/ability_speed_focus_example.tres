[gd_resource type="Resource" script_class="GameAbilityDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://content/core/abilities/definitions/game_ability_definition.gd" id="1_definition"]
[ext_resource type="Resource" path="res://content/gameplay/example/shared/effect_speed_boost_example.tres" id="2_effect"]
[ext_resource type="Script" path="res://content/core/abilities/operations/game_ability_apply_effect_operation.gd" id="3_apply_effect"]
[ext_resource type="Script" path="res://content/core/abilities/operations/game_ability_operation.gd" id="4_operation_base"]

[sub_resource type="Resource" id="Resource_apply_effect"]
script = ExtResource("3_apply_effect")
effect_definition = ExtResource("2_effect")
apply_to_owner = true

[resource]
script = ExtResource("1_definition")
ability_id = &"example.ability.speed_focus"
display_name = "Example Speed Focus"
debug_description = "Applies the equipment speed effect to the owner."
ability_tags = Array[StringName]([&"example.ability.equipment"])
required_owner_capabilities = Array[StringName]([&"effects.receiver", &"attributes.modify"])
required_owner_tags = Array[StringName]([])
blocked_owner_tags = Array[StringName]([&"state.dead"])
granted_tags_during_execution = Array[StringName]([])
cooldown_duration = 1.0
cooldown_key = &"example.cooldown.speed_focus"
cooldown_groups = Array[StringName]([])
occupied_channels = Array[StringName]([&"abilities"])
conflict_policy = 0
retrigger_policy = 0
operations = Array[ExtResource("4_operation_base")]([SubResource("Resource_apply_effect")])
passive = false
persist_grant = true
persist_cooldown = false
save_execution_policy = 0
schema_version = 1
