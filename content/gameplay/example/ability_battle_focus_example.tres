[sub_resource type="Resource" id="Resource_energy_cost"]
script = ExtResource("5_meter_cost")
meter_id = &"example.meter.energy"
amount = 25.0

[sub_resource type="Resource" id="Resource_apply_effect"]
script = ExtResource("3_apply_effect")
effect_definition = ExtResource("2_effect")
apply_to_owner = true

[resource]
script = ExtResource("1_definition")
ability_id = &"example.ability.battle_focus"
display_name = "Example Battle Focus"
debug_description = "Consumes 25 example energy and adds 5 example power for 10 seconds."
required_owner_capabilities = Array[StringName]([&"effects.receiver", &"meters.modify", &"attributes.modify"])
costs = Array[ExtResource("6_cost_base")]([SubResource("Resource_energy_cost")])
cooldown_duration = 12.0
cooldown_key = &"example.cooldown.battle_focus"
occupied_channels = Array[StringName]([&"abilities"])
operations = Array[ExtResource("4_operation_base")]([SubResource("Resource_apply_effect")])
